<UserControl x:Class="DynamicIsland.Windows.Views.AssistantReplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid x:Name="ActivityRow" Height="0" Opacity="0" ClipToBounds="True" IsHitTestVisible="False">
            <!-- Port of Sutra floating chat's .chatbot-thinking-bubble (source kept in Assets/Brand). -->
            <Border x:Name="ThinkingChip" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="14" BorderThickness="1" BorderBrush="#38B9A5FD">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35"><GradientStop Color="#1CB9A5FD" /><GradientStop Color="#0AB9A5FD" Offset="1" /></LinearGradientBrush></Border.Background>
                <Grid SizeChanged="Chip_SizeChanged">
                    <Grid.Clip><RectangleGeometry x:Name="ChipClip" RadiusX="13" RadiusY="13" /></Grid.Clip>
                    <StackPanel Orientation="Horizontal" Margin="12,7">
                        <TextBlock x:Name="StatusLabel" FontFamily="Segoe UI Variable Text" FontSize="13" VerticalAlignment="Center">
                            <TextBlock.Foreground><LinearGradientBrush x:Name="StatusGradient" StartPoint="0,0" EndPoint="1,0"><LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="LabelShimmer" /></LinearGradientBrush.RelativeTransform><GradientStop Color="#AAB5C6" /><GradientStop Color="#AAB5C6" Offset="0.38" /><GradientStop Color="#F7FAFF" Offset="0.5" /><GradientStop Color="#AAB5C6" Offset="0.62" /><GradientStop Color="#AAB5C6" Offset="1" /></LinearGradientBrush></TextBlock.Foreground>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot1" Width="4" Height="4" Fill="{DynamicResource QAccent}" Margin="0,0,3,0" Opacity="0.7"><Ellipse.RenderTransform><TranslateTransform x:Name="DotOffset1" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse x:Name="Dot2" Width="4" Height="4" Fill="{DynamicResource QAccent}" Margin="0,0,3,0" Opacity="0.7"><Ellipse.RenderTransform><TranslateTransform x:Name="DotOffset2" /></Ellipse.RenderTransform></Ellipse>
                            <Ellipse x:Name="Dot3" Width="4" Height="4" Fill="{DynamicResource QAccent}" Opacity="0.7"><Ellipse.RenderTransform><TranslateTransform x:Name="DotOffset3" /></Ellipse.RenderTransform></Ellipse>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.18"><LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ChipSheen" /></LinearGradientBrush.RelativeTransform><GradientStop Color="#00B9A5FD" Offset="0.3" /><GradientStop Color="#29B9A5FD" Offset="0.5" /><GradientStop Color="#00B9A5FD" Offset="0.7" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="Answer" Margin="0,2,0,0" FontFamily="Segoe UI Variable Text" FontSize="13" LineHeight="21" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource QText}" TextWrapping="Wrap">
            <TextBlock.RenderTransform><TranslateTransform x:Name="AnswerOffset" /></TextBlock.RenderTransform>
            <Run x:Name="AnswerText" /><InlineUIContainer BaselineAlignment="TextBottom"><Border x:Name="StreamingCaret" Width="5" Height="17" CornerRadius="1" Margin="2,0,0,0" Background="{DynamicResource QAccent}" Visibility="Collapsed" /></InlineUIContainer>
        </TextBlock>
    </StackPanel>
</UserControl>
