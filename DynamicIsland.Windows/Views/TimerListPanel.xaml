<UserControl x:Class="DynamicIsland.Windows.Views.TimerListPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TimerEditorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="EditorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <Grid x:Name="TimerLayout" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding StorageWarning}" Foreground="#FFFFB86C" TextWrapping="Wrap" Margin="0,0,0,6" />
            <Expander x:Name="MissedAlerts" Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding HasMissedAlerts, Converter={StaticResource BoolToVisibility}}" Header="Missed alerts" Foreground="#CCD0D8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding MissedSummary}" TextWrapping="Wrap" />
                    <Button Content="Clear summary" Command="{Binding ClearMissedCommand}" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <StackPanel x:Name="TimerRingPanel" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,22,12"><Grid Width="250" Height="250">
                <Ellipse Width="250" Height="250" Stroke="{Binding DataContext.AccentSoftBrush, RelativeSource={RelativeSource AncestorType=Window}}" StrokeThickness="1" />
                <Ellipse Width="250" Height="250" Stroke="#FF333039" StrokeThickness="7" />
                <Ellipse Width="250" Height="250"
                         Stroke="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                         StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Ellipse.StrokeDashArray>
                        <MultiBinding Converter="{StaticResource RingProgress}">
                            <Binding Path="TimerRemainingProgress" />
                            <Binding Path="TimerRingPerimeterUnits" />
                        </MultiBinding>
                    </Ellipse.StrokeDashArray>
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="125" CenterY="125" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding TimerLabel}" Foreground="#9998A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TimerRemaining}" FontFamily="Segoe UI Variable Display" FontSize="50" FontWeight="SemiBold"
                               Foreground="#FFF5F5F7" HorizontalAlignment="Center" />
                    <Border Background="{Binding DataContext.AccentSoftBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderBrush="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderThickness="0" CornerRadius="12" Padding="9,4" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TimerStateText}"
                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="{Binding TimerPrimaryText}" Command="{Binding TimerPrimaryCommand}" Style="{StaticResource TimerPrimaryButton}" MinWidth="100" MinHeight="48" FontSize="15" Margin="0,0,8,0" />
                    <Button Content="Reset" Command="{Binding ResetTimerCommand}" Style="{StaticResource TimerSurfaceButton}" MinWidth="78" MinHeight="48" FontSize="15" />
                </StackPanel></StackPanel>

            <StackPanel x:Name="OptionsPanel" Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Margin="22,4,0,0">
                <TextBlock Text="Your timers" Foreground="#FF9998A4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="TimerItemsList" ItemsSource="{Binding Timers}" SelectedValuePath="Id" SelectedValue="{Binding SelectedTimerId}"
                         MaxHeight="144" Margin="0,0,0,14" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch" AutomationProperties.Name="Timers">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,4,6" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="180" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemChrome" Background="#FF232129" BorderBrush="#FF494054" BorderThickness="1" CornerRadius="12" Padding="10,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemChrome" Property="Background"
                                                        Value="{Binding DataContext.AccentSoftBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Setter TargetName="ItemChrome" Property="BorderBrush"
                                                        Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemChrome" Property="BorderBrush"
                                                        Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text}" Foreground="#FFB7C7DF" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="&#xE711;" Command="{Binding DataContext.EndTimerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding Id}" Style="{StaticResource TimerChipDeleteButton}" Margin="6,0,0,0"
                                        ToolTip="End timer" AutomationProperties.Name="End timer" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="No timers yet. Start one below." Foreground="#FF9998A4" FontSize="12" Margin="0,0,0,14">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Timers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Quick start" Foreground="#FF9998A4" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                <WrapPanel Margin="-3,0,0,10">
                    <Button Content="5m" Command="{Binding StartPresetCommand}" CommandParameter="5" Style="{StaticResource TimerSurfaceButton}" Margin="3" MinWidth="68" />
                    <Button Content="10m" Command="{Binding StartPresetCommand}" CommandParameter="10" Style="{StaticResource TimerSurfaceButton}" Margin="3" MinWidth="68" />
                    <Button Content="15m" Command="{Binding StartPresetCommand}" CommandParameter="15" Style="{StaticResource TimerSurfaceButton}" Margin="3" MinWidth="68" />
                    <Button Content="25m" Command="{Binding StartPresetCommand}" CommandParameter="25" Style="{StaticResource TimerSurfaceButton}" Margin="3" MinWidth="68" />
                    <Button Content="30m" Command="{Binding StartPresetCommand}" CommandParameter="30" Style="{StaticResource TimerSurfaceButton}" Margin="3" MinWidth="68" />
                </WrapPanel>

                <TextBlock Text="Custom duration" Foreground="#9998A4" FontSize="11" Margin="0,14,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="HOURS" FontSize="9" Foreground="#9998A4" Margin="0,0,0,5"/><TextBox Text="{Binding CustomHours}" Style="{StaticResource TimerTextBox}" FontSize="22" HorizontalContentAlignment="Center" AutomationProperties.Name="Timer hours"/></StackPanel>
                  <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Bottom" FontSize="22" Foreground="#777681" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                  <StackPanel Grid.Column="2"><TextBlock Text="MINUTES" FontSize="9" Foreground="#9998A4" Margin="0,0,0,5"/><TextBox Text="{Binding CustomMinutes}" Style="{StaticResource TimerTextBox}" FontSize="22" HorizontalContentAlignment="Center" AutomationProperties.Name="Timer minutes"/></StackPanel>
                  <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Bottom" FontSize="22" Foreground="#777681" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                  <StackPanel Grid.Column="4"><TextBlock Text="SECONDS" FontSize="9" Foreground="#9998A4" Margin="0,0,0,5"/><TextBox Text="{Binding CustomSeconds}" Style="{StaticResource TimerTextBox}" FontSize="22" HorizontalContentAlignment="Center" AutomationProperties.Name="Timer seconds"/></StackPanel>
                </Grid>
                <TextBlock Text="Label" Foreground="#FF9998A4" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6" />
                <TextBox Text="{Binding TimerLabel}" Style="{StaticResource TimerTextBox}" ToolTip="Optional timer label" />
                <Button Visibility="Collapsed" Content="Add alarm from this label" Command="{Binding UseTimerLabelForAlarmCommand}" Style="{StaticResource TimerSurfaceButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" ToolTip="Open Alarm with this label ready to schedule" />

                <Button Content="Start timer" Command="{Binding StartCustomCommand}" Style="{StaticResource TimerPrimaryButton}" Height="42" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFFB86C" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,10,0,0" />
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
