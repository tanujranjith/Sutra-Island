<UserControl x:Class="DynamicIsland.Windows.Views.GraphiteIslandView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DynamicIsland.Windows.Views">
 <UserControl.Resources>
  <Style x:Key="Ink" TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding PrimaryTextBrush, Mode=OneWay}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Ink}"><Setter Property="Foreground" Value="{Binding SecondaryTextBrush, Mode=OneWay}"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="Icon" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{Binding PrimaryTextBrush, Mode=OneWay}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" CornerRadius="9" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#16FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#25B9A5FD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Track" TargetType="ProgressBar"><Setter Property="Height" Value="3"/><Setter Property="Foreground" Value="{Binding AccentBrush, Mode=OneWay}"/><Setter Property="Background" Value="{Binding ProgressTrackBrush, Mode=OneWay}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><views:SutraMascotView Width="30" Height="30" ReducedMotion="{Binding IsReducedMotion, Mode=OneWay}"/><TextBlock Text="Sutra Island" Style="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/><Border Width="1" Height="14" Background="{Binding IslandDividerBrush, Mode=OneWay}" Margin="10,0"/><TextBlock Text="Media &amp; system" Style="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="GraphiteAssistantButton" Style="{StaticResource Icon}" Click="Assistant_Click" ToolTip="Open Sutra Assistant" AutomationProperties.Name="Open Sutra Assistant"><Border Width="21" Height="21" CornerRadius="6" Background="{StaticResource SutraAssistantBrandBrush}"/></Button>
    <Button Content="&#xE916;" Style="{StaticResource Icon}" Click="Timer_Click" ToolTip="Timer" AutomationProperties.Name="Open timer"/>
    <Button Content="&#xE713;" Style="{StaticResource Icon}" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Open settings"/>
    <Border Width="1" Height="22" Background="{Binding IslandDividerBrush, Mode=OneWay}" Margin="8,0"/>
    <Button Content="&#xE712;" Style="{StaticResource Icon}" Click="More_Click" ToolTip="More island controls"><Button.ContextMenu><ContextMenu Opened="MoreMenu_Opened" Closed="MoreMenu_Closed"><MenuItem Header="Pin media" Command="{Binding PinMediaCommand, Mode=OneWay}"/><MenuItem Header="Pin selected timer" Command="{Binding PinTimerCommand, Mode=OneWay}"/><MenuItem Header="Automatic activity" Command="{Binding UnpinActivityCommand, Mode=OneWay}"/><Separator/><MenuItem Header="Settings" Click="Settings_Click"/><MenuItem Header="Timer" Click="Timer_Click"/><MenuItem Header="Sutra Assistant" Click="Assistant_Click"/><MenuItem Header="Recenter island" Click="Recenter_Click"/></ContextMenu></Button.ContextMenu></Button>
    <Button Content="&#xE70E;" Style="{StaticResource Icon}" Command="{Binding ToggleExpandedCommand, Mode=OneWay}" ToolTip="Collapse island" AutomationProperties.Name="Collapse island"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="25,9,25,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Grid Margin="0,6,26,2" Visibility="{Binding ShowMedia, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid Width="{Binding ExpandedAlbumSize, Mode=OneWay}" Height="{Binding ExpandedAlbumSize, Mode=OneWay}" VerticalAlignment="Top" Margin="0,0,18,0" Cursor="Hand" MouseLeftButtonUp="Artwork_Click"><Border CornerRadius="12" Background="{Binding IslandCardBrush, Mode=OneWay}"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{Binding SecondaryTextBrush, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><Border CornerRadius="12" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}"><Border.Background><ImageBrush ImageSource="{Binding Artwork, Mode=OneWay}" Stretch="UniformToFill"/></Border.Background></Border></Grid>
    <StackPanel Grid.Column="1">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="{Binding AccentBrush, Mode=OneWay}" Margin="0,0,7,0"/><TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{Binding AccentBrush, Mode=OneWay}"/></StackPanel>
     <Grid Margin="0,13,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding MediaTitle, Mode=OneWay}" Style="{StaticResource Ink}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <StackPanel x:Name="GraphiteEqualizer" Grid.Column="1" Orientation="Horizontal" Height="28" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding ShowMusicVisualizer, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
       <Rectangle Width="3" Height="{Binding VisualizerBar0Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
       <Rectangle Width="3" Height="{Binding VisualizerBar1Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
       <Rectangle Width="3" Height="{Binding VisualizerBar2Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
       <Rectangle Width="3" Height="{Binding VisualizerBar3Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
       <Rectangle Width="3" Height="{Binding VisualizerBar4Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
       <Rectangle Width="3" Height="{Binding VisualizerBar5Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
       <Rectangle Width="3" Height="{Binding VisualizerBar6Height}" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="1,0"/>
      </StackPanel></Grid>
     <TextBlock Text="{Binding MediaArtist, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis"/>
     <Border Height="14" Margin="0,12,0,0" Background="Transparent" MouseLeftButtonUp="Seek_Click" Cursor="Hand" ToolTip="Seek in the current track"><ProgressBar Value="{Binding MediaProgress, Mode=OneWay}" Style="{StaticResource Track}" Height="4" VerticalAlignment="Center" IsHitTestVisible="False"/></Border>
     <Grid Margin="0,2,0,0" Visibility="{Binding ShowMediaTimes, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding MediaElapsedText, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding MediaTrailingTimeText, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></Grid>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"><Button Content="&#xE892;" Command="{Binding PreviousCommand, Mode=OneWay}" Style="{StaticResource Icon}" Margin="0,0,16,0" ToolTip="Previous track"/><Button x:Name="GraphiteSeekBack" Command="{Binding SeekBackCommand, Mode=OneWay}" Style="{StaticResource Icon}" Margin="8,0" ToolTip="{Binding SeekBackTooltip, Mode=OneWay}" AutomationProperties.Name="Back 30 seconds"><Grid Width="28" Height="28"><Path Data="M 6,9 A 10,10 0 1 1 5,19 M 6,3 L 6,10 L 13,10" Stroke="{Binding PrimaryTextBrush, Mode=OneWay}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"></Path><TextBlock Text="30" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="{Binding PrimaryTextBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/></Grid></Button><Button Content="{Binding PlayPauseGlyph, Mode=OneWay}" Command="{Binding PlayPauseCommand, Mode=OneWay}" Style="{StaticResource Icon}" Background="{Binding AccentBrush, Mode=OneWay}" Foreground="#201A2B" ToolTip="Play or pause"/><Button x:Name="GraphiteSeekForward" Command="{Binding SeekForwardCommand, Mode=OneWay}" Style="{StaticResource Icon}" Margin="8,0" ToolTip="{Binding SeekForwardTooltip, Mode=OneWay}" AutomationProperties.Name="Forward 30 seconds"><Grid Width="28" Height="28"><Path Data="M 6,9 A 10,10 0 1 1 5,19 M 6,3 L 6,10 L 13,10" Stroke="{Binding PrimaryTextBrush, Mode=OneWay}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform></Path><TextBlock Text="30" FontFamily="Segoe UI Variable Text" FontSize="8" Foreground="{Binding PrimaryTextBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/></Grid></Button><Button Content="&#xE893;" Command="{Binding NextCommand, Mode=OneWay}" Style="{StaticResource Icon}" Margin="16,0,0,0" ToolTip="Next track"/></StackPanel>
    </StackPanel>
   </Grid>
   <Border Grid.Column="1" BorderBrush="{Binding IslandDividerBrush, Mode=OneWay}" BorderThickness="1,0,0,0" Padding="26,5,0,0"><StackPanel>
    <Grid><StackPanel><TextBlock Text="{Binding ClockText, Mode=OneWay}" Style="{StaticResource Ink}" FontSize="30" FontWeight="SemiBold" Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding DateText, Mode=OneWay}" Style="{StaticResource Muted}" Margin="0,4,0,0" ToolTip="{Binding DateLongText, Mode=OneWay}" Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}"/></StackPanel><Border VerticalAlignment="Top" HorizontalAlignment="Right" CornerRadius="12" Padding="8,5" Background="#18AD843A" ToolTip="{Binding PrivacyDetailText, Mode=OneWay}" Visibility="{Binding ShowPrivacyInUse, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding PrivacyActivityText, Mode=OneWay}" Foreground="#E8B86E" FontSize="9"/></Border></Grid>
    <Border Height="1" Background="{Binding IslandDividerBrush, Mode=OneWay}" Margin="0,15,0,10"/>
    <Grid Visibility="{Binding ShowSystemMonitor, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Memory" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding RamText, Mode=OneWay}" Style="{StaticResource Ink}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,8"/><ProgressBar Value="{Binding RamPercentValue, Mode=OneWay}" Style="{StaticResource Track}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Network" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding NetText, Mode=OneWay}" Style="{StaticResource Ink}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,5,0,9"/><Polyline Points="{Binding NetSparkline, Mode=OneWay}" Stroke="{Binding AccentBrush, Mode=OneWay}" StrokeThickness="1.5" Stretch="Fill" Height="4"/></StackPanel></Grid>
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{Binding SecondaryTextBrush, Mode=OneWay}" Margin="0,0,7,0"/><TextBlock Text="Live system activity" Style="{StaticResource Muted}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding ShowBattery, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding BatteryGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" Foreground="{Binding SecondaryTextBrush, Mode=OneWay}" Margin="0,0,5,0"/><TextBlock Text="{Binding BatteryText, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel>
   </StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{Binding IslandDividerBrush, Mode=OneWay}" BorderThickness="0,1,0,0" Margin="25,0,25,22" Background="#03FFFFFF"><Grid Height="56"><Grid.ColumnDefinitions><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="1.05*"/><Style.Triggers><DataTrigger Binding="{Binding ShowVolume}" Value="False"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding ShowConnectivity}" Value="False"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value=".85*"/><Style.Triggers><DataTrigger Binding="{Binding ShowConnectivity}" Value="False"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding ShowWeather}" Value="False"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition></Grid.ColumnDefinitions>
   <Border BorderBrush="{Binding IslandDividerBrush, Mode=OneWay}" BorderThickness="0,0,1,0" Padding="12,8" Visibility="{Binding ShowVolume, Converter={StaticResource BoolToVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{Binding VolumeGlyph, Mode=OneWay}" Command="{Binding ToggleMuteCommand, Mode=OneWay}" Style="{StaticResource Icon}" Width="25" Height="28" Foreground="{Binding AccentBrush, Mode=OneWay}" ToolTip="Mute or unmute"/><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Volume" Style="{StaticResource Ink}" FontSize="12"/><TextBlock Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"><Run Text="{Binding VolumeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding OutputDeviceText, Mode=OneWay}"/></TextBlock></StackPanel><Button x:Name="GraphiteOutputButton" Grid.Column="2" Content="&#xE70D;" Style="{StaticResource Icon}" Width="24" Click="Output_Click" ToolTip="Choose audio output"/></Grid></Border>
   <Border Grid.Column="1" BorderBrush="{Binding IslandDividerBrush, Mode=OneWay}" BorderThickness="0,0,1,0" Padding="13,8" Visibility="{Binding ShowConnectivity, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{Binding SecondaryTextBrush, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,11,0"/><StackPanel><TextBlock Text="{Binding WifiStatusText, Mode=OneWay}" Style="{StaticResource Ink}" FontSize="12"/><TextBlock Text="Wi-Fi" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
   <Border Grid.Column="2" BorderBrush="{Binding IslandDividerBrush, Mode=OneWay}" BorderThickness="0,0,1,0" Padding="13,8" Visibility="{Binding ShowConnectivity, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{Binding SecondaryTextBrush, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,11,0"/><StackPanel><TextBlock Text="Bluetooth" Style="{StaticResource Ink}" FontSize="12"/><TextBlock Text="{Binding BluetoothStatusText, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
   <Border Grid.Column="3" Padding="13,8" Visibility="{Binding ShowWeather, Converter={StaticResource BoolToVisibility}}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding WeatherGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="#E8B86E" VerticalAlignment="Center" Margin="0,0,11,0"/><StackPanel><TextBlock Style="{StaticResource Ink}" FontSize="12"><Run Text="{Binding WeatherTempText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding WeatherDescText, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding WeatherCityText, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel></Border>
  </Grid></Border>
 </Grid>
</UserControl>
