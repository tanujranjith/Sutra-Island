<UserControl x:Class="DynamicIsland.Windows.Views.CompactEqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="0" Height="28" Opacity="0" ClipToBounds="True" IsHitTestVisible="False" Focusable="False">
    <StackPanel Orientation="Horizontal" Width="32.5" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Rectangle Width="2" Height="{Binding VisualizerBar0Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
        <Rectangle Width="2" Height="{Binding VisualizerBar1Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
        <Rectangle Width="2" Height="{Binding VisualizerBar2Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
        <Rectangle Width="2" Height="{Binding VisualizerBar3Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
        <Rectangle Width="2" Height="{Binding VisualizerBar4Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
        <Rectangle Width="2" Height="{Binding VisualizerBar5Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
        <Rectangle Width="2" Height="{Binding VisualizerBar6Height}" RadiusX="1" RadiusY="1" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0.75,0" />
    </StackPanel>
</UserControl>
