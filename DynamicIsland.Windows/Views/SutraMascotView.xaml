<UserControl x:Class="DynamicIsland.Windows.Views.SutraMascotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" UseLayoutRounding="False" SnapsToDevicePixels="False" RenderOptions.BitmapScalingMode="HighQuality">
    <!-- Preserve the supplied ribbon artwork. The continuous face surface and live eyes are UI layers;
         neither source PNG is modified. Coordinates refer to its original 1254px canvas. -->
    <Grid ClipToBounds="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="902.88" Height="902.88" ClipToBounds="True">
            <Grid.Clip><RectangleGeometry Rect="0,0,902.88,902.88" RadiusX="230" RadiusY="230" /></Grid.Clip>
            <Canvas Width="1254" Height="1254" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas.RenderTransform><TranslateTransform X="-175.56" Y="-175.56" /></Canvas.RenderTransform>
                <Image Width="1254" Height="1254" Source="{StaticResource SutraMascotArtwork}" Stretch="Fill" />
                <!-- Compact voice errors: a grey-blue, desaturated mascot. The greyscale copy is built in code. -->
                <Image x:Name="GreyArtwork" Width="1254" Height="1254" Stretch="Fill" Visibility="Collapsed" />
                <Rectangle x:Name="GreyTint" Width="1254" Height="1254" Fill="#59788AA0" Visibility="Collapsed" />
                <!-- One continuous face surface avoids raster cover seams and ghost irises at small sizes. -->
                <Path Data="M374,622 C395,506 504,422 623,421 C755,417 875,507 872,608 C879,682 800,755 692,777 C549,751 439,697 374,622 Z">
                    <Path.Fill><RadialGradientBrush GradientOrigin="0.46,0.44" Center="0.5,0.46" RadiusX="0.66" RadiusY="0.7"><GradientStop Color="#FFFEFCFB" /><GradientStop Color="#FFFEFCFB" Offset="0.42" /><GradientStop Color="#FFE3D8E9" Offset="0.76" /><GradientStop Color="#FFB6A0CF" Offset="1" /></RadialGradientBrush></Path.Fill>
                </Path>
                <Canvas x:Name="Eyes" Width="1254" Height="1254">
                    <Canvas.RenderTransform><TranslateTransform x:Name="Gaze" /></Canvas.RenderTransform>
                    <Canvas x:Name="OpenEyes" Width="1254" Height="1254">
                        <Canvas.RenderTransform><ScaleTransform x:Name="Blink" CenterY="609" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="489" Canvas.Top="544" Width="68" Height="130" RadiusX="34" RadiusY="34">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#161BD2" /><GradientStop Color="#031274" Offset="0.5" /><GradientStop Color="#0051F2" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Canvas.Left="697" Canvas.Top="544" Width="68" Height="130" RadiusX="34" RadiusY="34">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1820D2" /><GradientStop Color="#071370" Offset="0.5" /><GradientStop Color="#4326ED" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                    <!-- Expressions for the compact voice orb: happy closed arcs (answers, commands) and flat lines (errors). -->
                    <Path x:Name="HappyEyes" Visibility="Collapsed" Stroke="#FF161E5C" StrokeThickness="30" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 489,626 Q 523,566 557,626 M 697,626 Q 731,566 765,626" />
                    <Path x:Name="FlatEyes" Visibility="Collapsed" Stroke="#FF464E60" StrokeThickness="30" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 482,612 H 564 M 690,612 H 772" />
                </Canvas>
            </Canvas>
        </Grid>
    </Viewbox>
        <Border x:Name="CornerBulb" Width="16" Height="19" CornerRadius="0" Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-10,0" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Sutra Assistant lightbulb">
            <Viewbox Stretch="Uniform">
                        <Grid x:Name="ThinkingMark" Width="22" Height="24" VerticalAlignment="Center" Margin="0" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Sutra Assistant lightbulb">
                            <Grid.RenderTransform><TranslateTransform x:Name="BulbFloat" /></Grid.RenderTransform>
                            <Path Stroke="#FFB87918" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M11,0.8 V2 M3.1,3.1 L4.2,4.2 M18.9,3.1 L17.8,4.2 M1.1,10 H2.7 M20.9,10 H19.3" />
                            <Path Fill="#FFFFC84A" Stroke="#FFB87918" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M11,3.25 C7.45,3.25 4.75,5.95 4.75,9.35 C4.75,11.8 6,13.35 7.7,15.05 C8.3,15.65 8.6,16.2 8.6,17 H13.4 C13.4,16.2 13.7,15.65 14.3,15.05 C16,13.35 17.25,11.8 17.25,9.35 C17.25,5.95 14.55,3.25 11,3.25 Z" />
                            <Path Stroke="#FF8E969F" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8.7,18.8 H13.3 M9.2,20.7 H12.8 M10,22.6 H12" />
                        </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
