<UserControl x:Class="DynamicIsland.Windows.Views.SutraMascotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" UseLayoutRounding="False" SnapsToDevicePixels="False" RenderOptions.BitmapScalingMode="HighQuality">
    <!-- Preserve the supplied ribbon artwork. The continuous face surface and live eyes are UI layers;
         neither source PNG is modified. Coordinates refer to its original 1254px canvas. -->
    <Grid ClipToBounds="False">
    <Viewbox Stretch="Uniform">
        <Grid Width="902.88" Height="902.88" ClipToBounds="True">
            <Grid.Clip><RectangleGeometry Rect="0,0,902.88,902.88" RadiusX="230" RadiusY="230" /></Grid.Clip>
            <Canvas Width="1254" Height="1254" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas.RenderTransform><TranslateTransform X="-175.56" Y="-175.56" /></Canvas.RenderTransform>
                <Image Width="1254" Height="1254" Source="{StaticResource SutraMascotArtwork}" Stretch="Fill" />
                <!-- One continuous face surface avoids raster cover seams and ghost irises at small sizes. -->
                <Path Data="M374,622 C395,506 504,422 623,421 C755,417 875,507 872,608 C879,682 800,755 692,777 C549,751 439,697 374,622 Z">
                    <Path.Fill><RadialGradientBrush GradientOrigin="0.46,0.44" Center="0.5,0.46" RadiusX="0.66" RadiusY="0.7"><GradientStop Color="#FFFEFCFB" /><GradientStop Color="#FFFEFCFB" Offset="0.42" /><GradientStop Color="#FFE3D8E9" Offset="0.76" /><GradientStop Color="#FFB6A0CF" Offset="1" /></RadialGradientBrush></Path.Fill>
                </Path>
                <Canvas x:Name="Eyes" Width="1254" Height="1254">
                    <Canvas.RenderTransform><TranslateTransform x:Name="Gaze" /></Canvas.RenderTransform>
                    <Canvas Width="1254" Height="1254">
                        <Canvas.RenderTransform><ScaleTransform x:Name="Blink" CenterY="609" /></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="489" Canvas.Top="544" Width="68" Height="130" RadiusX="34" RadiusY="34">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#161BD2" /><GradientStop Color="#031274" Offset="0.5" /><GradientStop Color="#0051F2" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Canvas.Left="697" Canvas.Top="544" Width="68" Height="130" RadiusX="34" RadiusY="34">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#1820D2" /><GradientStop Color="#071370" Offset="0.5" /><GradientStop Color="#4326ED" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Grid>
    </Viewbox>
        <Border x:Name="CornerBulb" Width="16" Height="16" CornerRadius="8" Background="#FF141C24" BorderBrush="#AAAC8243" BorderThickness="0.7"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Assistant is thinking">
            <Viewbox Stretch="Uniform">
                        <Grid x:Name="ThinkingMark" Width="22" Height="22" VerticalAlignment="Center" Margin="0" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Assistant is working">
                            <Grid.RenderTransform><ScaleTransform x:Name="BulbScale" /></Grid.RenderTransform>
                            <Ellipse x:Name="BulbGlow" Width="21" Height="21" Fill="#30FFD88A" Opacity="0.3" />
                            <Path x:Name="BulbRays" Stroke="#FFD88A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.5" Data="M11,0.8 V2 M2.7,3.4 L3.6,4.3 M19.3,3.4 L18.4,4.3 M0.8,10 H2.2 M21.2,10 H19.8" />
                            <Path Fill="#30FFD88A" Stroke="#FFE3A7" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M11,4 C7.6,4 5.5,6.3 5.5,9.4 C5.5,12.1 7.1,13.4 8.3,14.7 V17 H13.7 V14.7 C14.9,13.4 16.5,12.1 16.5,9.4 C16.5,6.3 14.4,4 11,4 Z" />
                            <Path Stroke="#FFE3A7" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,19 H13 M10,21 H12 M9,10 L11,12 L13,10 M11,12 V16" />
                        </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
