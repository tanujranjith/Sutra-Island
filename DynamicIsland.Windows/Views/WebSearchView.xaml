<UserControl x:Class="DynamicIsland.Windows.Views.WebSearchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:DynamicIsland.Windows.Views">
 <UserControl.Resources>
  <Style x:Key="SourceCardStyle" TargetType="Button">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Card" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource QAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource QAccent}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel x:Name="Layout" Visibility="Collapsed" Margin="0,0,0,10">
  <StackPanel x:Name="SearchRow" Orientation="Horizontal" Margin="0,1,0,4" AutomationProperties.LiveSetting="Polite">
   <views:SearchGlobe x:Name="Globe" Width="24" Height="24" Margin="0,0,9,0" />
   <TextBlock x:Name="DoneMark" Text="✓" FontSize="18" Foreground="#91DFC1" Width="24" Margin="0,0,9,0" Visibility="Collapsed" />
   <TextBlock x:Name="SearchLabel" FontSize="13" VerticalAlignment="Center">
    <TextBlock.Foreground><LinearGradientBrush x:Name="ShimmerBrush" StartPoint="0,0" EndPoint="1,0"><LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="Shimmer" /></LinearGradientBrush.RelativeTransform><GradientStop Color="#B3A4CD"/><GradientStop Color="#B3A4CD" Offset="0.36"/><GradientStop Color="#F1E9FF" Offset="0.5"/><GradientStop Color="#B3A4CD" Offset="0.64"/><GradientStop Color="#B3A4CD" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
   </TextBlock>
  </StackPanel>
  <TextBlock x:Name="SourceCount" FontSize="11" Foreground="{DynamicResource QMuted}" Margin="33,0,0,8" />
  <WrapPanel x:Name="SourceCards" />
  <Button x:Name="MoreSources" Content="Show all sources" Click="MoreSources_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,4,0,0" Padding="7,3" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource QAccent}" />
  <TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource QMuted}" Margin="0,5,0,0" />
  <Border x:Name="SuggestionsHost" Margin="0,8,0,0" Visibility="Collapsed" />
 </StackPanel>
</UserControl>
