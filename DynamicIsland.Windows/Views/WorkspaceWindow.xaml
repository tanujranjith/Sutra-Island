<Window x:Class="DynamicIsland.Windows.Views.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sutra Island Workspace" Width="550" Height="495" MinWidth="420" MinHeight="370"
        WindowStartupLocation="CenterOwner" Background="#17181D" Foreground="#F4F1FA"
        FontFamily="Segoe UI Variable Text" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="#F4F1FA" />
            <Setter Property="Background" Value="#30313C" />
            <Setter Property="BorderBrush" Value="#494A57" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#414251"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#4B4266"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#15161B" />
            <Setter Property="Foreground" Value="#F4F1FA" />
            <Setter Property="BorderBrush" Value="#373844" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#202129" />
            <Setter Property="Foreground" Value="#F4F1FA" />
            <Setter Property="BorderBrush" Value="#494A57" />
            <Setter Property="CaretBrush" Value="#F4F1FA" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#F4F1FA" />
            <Setter Property="Background" Value="#292A34" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5,5,0,0" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#48405C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="Workspace" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" Foreground="#C8B8EE" Margin="0,10,0,0"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TabControl x:Name="Tabs" Background="#202129" BorderBrush="#373844">
            <TabItem Header="Drop Tray">
                <DockPanel Margin="12" AllowDrop="True" DragOver="Tray_DragOver" Drop="Tray_Drop">
                    <TextBlock DockPanel.Dock="Top" Text="Drop files, screenshots or links here. Drag an item out to use it."
                               TextWrapping="Wrap" Foreground="#CDC8D9" Margin="0,0,0,10" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Paste" Click="Paste_Click"/>
                        <Button Content="Copy item" Click="CopyTrayItem_Click"/>
                        <Button Content="Copy file to…" Click="CopyTrayFile_Click"/>
                        <Button Content="Remove" Click="RemoveTrayItem_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="TrayList" DisplayMemberPath="Label" AutomationProperties.Name="Items in the drop tray"
                             PreviewMouseLeftButtonDown="TrayItem_MouseDown" PreviewMouseMove="TrayItem_MouseMove"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Transfers">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Download URL" Foreground="#CDC8D9" Margin="0,0,0,5"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Download…" Click="Download_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="DownloadUrl" AutomationProperties.Name="Download URL"/>
                        </DockPanel>
                        <Button Content="Copy files…" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ChooseFiles_Click"/>
                    </StackPanel>
                    <ListBox x:Name="TransferList" AutomationProperties.Name="Transfer progress">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,7">
                                    <Button DockPanel.Dock="Right" Content="Open folder" Tag="{Binding}" Click="OpenTransferFolder_Click"
                                            Visibility="{Binding CanOpenFolder, Converter={StaticResource VisibleWhenTrue}}"/>
                                    <Button DockPanel.Dock="Right" Content="Cancel" Tag="{Binding}" Click="CancelTransfer_Click"
                                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#CDC8D9"/>
                                        <ProgressBar Height="5" Margin="0,5,8,0" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Pinned">
                <StackPanel Margin="12">
                    <TextBlock Text="Keep one item visible in the compact island." TextWrapping="Wrap" Foreground="#CDC8D9" Margin="0,0,0,10"/>
                    <ComboBox x:Name="PinChoice" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectionChanged="PinChoice_SelectionChanged" AutomationProperties.Name="Pinned item"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Quick Capture">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBox x:Name="NoteInput" Height="78" AcceptsReturn="True" MaxLength="4000" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="NoteInput_KeyDown" AutomationProperties.Name="Quick note"/>
                        <Button Content="Save note" Click="SaveNote_Click" ToolTip="Ctrl+Enter" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Copy note" Click="CopyNote_Click"/>
                        <Button Content="Remove note" Click="RemoveNote_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="NotesList" AutomationProperties.Name="Saved notes">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="#B5AACB" FontSize="11"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
