<UserControl x:Class="DynamicIsland.Windows.Views.CommandToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="Tools_PreviewKeyDown">
    <UserControl.Resources>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#FF665E75" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="ToolSearchInput" TargetType="TextBox"><Setter Property="Foreground" Value="#F4F2F4"/><Setter Property="CaretBrush" Value="#B9A5FD"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="SearchBorder" CornerRadius="10" Background="#7024252B" BorderBrush="#50473F55" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchBorder" Property="BorderBrush" Value="#B9A5FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="#909BAD" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style x:Key="ToolRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E0E6F0" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Padding" Value="12,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" CornerRadius="11" Background="#7024252B" BorderBrush="#50473F55" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#748BAE" /><Setter TargetName="Row" Property="Background" Value="#FF2A303C" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#58677D" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F2F4" /><Setter Property="Background" Value="#7024252B" /><Setter Property="Padding" Value="12,9" /><Setter Property="MinHeight" Value="38" />
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F2F4" /><Setter Property="Padding" Value="12,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="#FF1D1F25" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#98362F42" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#98362F42" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#7024252B" CornerRadius="10" BorderBrush="#50473F55" BorderThickness="1" /></ControlTemplate></ToggleButton.Template></ToggleButton>
                    <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" Margin="12,8,28,8" IsHitTestVisible="False" VerticalAlignment="Center" />
                    <TextBlock Text="⌄" Foreground="#A0AEC4" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#FF1D1F25" BorderBrush="#50473F55" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="230"><StackPanel IsItemsHost="True" /></ScrollViewer></Border></Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="8,4,8,8">
        <Grid Margin="-4,0,-4,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Style="{DynamicResource AudioIconButton}" Click="Back_Click" ToolTip="Back to commands" AutomationProperties.Name="Back to commands" />
            <TextBlock Grid.Column="1" Text="{Binding ToolTitle}" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#8E96A5" Style="{DynamicResource AudioIconButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close panel" />
        </Grid>

        <StackPanel Visibility="{Binding IsStopwatchPanel, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="{Binding Stopwatch.StopwatchText}" FontFamily="Consolas" FontSize="38" TextAlignment="Center" Margin="0,5,0,19" />
            <UniformGrid Columns="3"><Button x:Name="StopwatchPrimary" Command="{Binding Stopwatch.StopwatchPrimaryCommand}" Content="{Binding Stopwatch.StopwatchPrimaryText}" Style="{DynamicResource CompactAudioButton}" Margin="0,0,7,0" /><Button Content="Lap" Command="{Binding Stopwatch.StopwatchLapCommand}" Style="{DynamicResource CompactAudioButton}" Margin="0,0,7,0" /><Button Content="Reset" Command="{Binding Stopwatch.StopwatchResetCommand}" Style="{DynamicResource CompactAudioButton}" /></UniformGrid>
            <TextBlock Text="LAPS" FontSize="10.5" Foreground="#7E8797" Margin="0,20,0,8" />
            <ListBox ItemsSource="{Binding Stopwatch.Laps}" MaxHeight="180" Background="Transparent" BorderThickness="0" Foreground="#CED7E6" ItemContainerStyle="{StaticResource ToolRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <TextBlock Text="Keeps running when this panel closes." Style="{StaticResource MutedText}" Margin="0,12,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsFocusPanel, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="Quiet the island and make room to concentrate." Style="{StaticResource MutedText}" Margin="0,0,0,16" />
            <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Island.FocusSessionActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:Name="FocusMinutesBox" Text="{Binding FocusMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PanelInput}" FontSize="30" TextAlignment="Center" MaxLength="8" AutomationProperties.Name="Focus duration in minutes" /><TextBlock Grid.Column="1" Text="minutes" Foreground="#A5B1C6" Margin="12,0,0,0" VerticalAlignment="Center" /></Grid>
                <UniformGrid Columns="4" Margin="0,14,0,17"><Button Content="15 min" Tag="15" Click="FocusPreset_Click" Style="{DynamicResource CompactAudioButton}" Margin="0,0,6,0" /><Button Content="25 min" Tag="25" Click="FocusPreset_Click" Style="{DynamicResource CompactAudioButton}" Margin="0,0,6,0" /><Button Content="50 min" Tag="50" Click="FocusPreset_Click" Style="{DynamicResource CompactAudioButton}" Margin="0,0,6,0" /><Button Content="90 min" Tag="90" Click="FocusPreset_Click" Style="{DynamicResource CompactAudioButton}" /></UniformGrid>
                <Button Content="Start focus" Click="StartFocus_Click" Style="{DynamicResource CompactAudioButton}" />
            </StackPanel>
            <StackPanel Visibility="{Binding Island.FocusSessionActive, Converter={StaticResource VisibleIf}}"><TextBlock Text="{Binding Island.FocusSessionRemaining}" FontFamily="Consolas" FontSize="40" TextAlignment="Center" Margin="0,2,0,18" /><Button Content="End session" Click="EndFocus_Click" Style="{DynamicResource CompactAudioButton}" /></StackPanel>
            <TextBlock Text="Your previous focus setting returns when the session ends." Style="{StaticResource MutedText}" Margin="0,16,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsClipboardPanel, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="Search clipboard" Foreground="#99A6BC" FontSize="11" Margin="1,0,0,7"/><TextBox x:Name="ClipboardSearchBox" Text="{Binding ClipFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolSearchInput}" ToolTip="Search clipboard text" AutomationProperties.Name="Search clipboard" />
            <ListBox ScrollViewer.CanContentScroll="False" x:Name="ClipboardList" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip, Mode=TwoWay}" Margin="0,12,0,0" MaxHeight="260" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ToolRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="ClipboardList_Click"><ListBox.Style><Style TargetType="ListBox"><Setter Property="Height" Value="260"/><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Height" Value="0"/></Trigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Background="#6017181D" CornerRadius="7" Margin="0,0,0,9" Visibility="{Binding HasThumbnail, Converter={StaticResource VisibleIf}}"><Image Source="{Binding Thumbnail}" Height="120" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Clipboard image preview" /></Border><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" FontSize="13" Foreground="#F4F2F4" /><TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="#9998A4" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ToolMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" /><Button Grid.Column="1" Content="Refresh" Click="RefreshClips_Click" Style="{DynamicResource CompactAudioButton}" /></Grid>
            <Button Content="Windows clipboard settings" Click="ClipboardSettings_Click" Style="{DynamicResource CompactAudioButton}" Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsNotificationsPanel, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="Search notifications" Foreground="#99A6BC" FontSize="11" Margin="1,0,0,7"/><TextBox x:Name="NotificationSearchBox" Text="{Binding NotificationFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolSearchInput}" ToolTip="Search apps, titles and messages" AutomationProperties.Name="Search notifications" />
            <UniformGrid Columns="3" Margin="0,12,0,12"><Button Content="{Binding MirroringLabel}" Click="Mirroring_Click" Style="{DynamicResource CompactAudioButton}" Margin="0,0,6,0" /><Button Content="Dismiss banner" Click="DismissBanner_Click" Style="{DynamicResource CompactAudioButton}" Margin="0,0,6,0" /><Button Content="Clear history" Click="ClearHistory_Click" Style="{DynamicResource CompactAudioButton}" /></UniformGrid>
            <ListBox ItemsSource="{Binding PanelNotifications}" MaxHeight="270" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ToolRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding App}" Foreground="#A8BAD5" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat={}{0:t}}" Foreground="#7E8BA0" FontSize="10" Margin="10,0,0,0" /></Grid><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E0E6F0" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,4,0,0" /><TextBlock Text="{Binding Body}" Foreground="#939FB2" MaxHeight="34" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Style="{DynamicResource AudioIconButton}" Click="RemoveNotification_Click" ToolTip="Remove from history" AutomationProperties.Name="Remove notification from history" Margin="8,0,0,0" VerticalAlignment="Top" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox><TextBlock Text="{Binding ToolMessage}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsConvertPanel, Converter={StaticResource VisibleIf}}">
            <ComboBox x:Name="ConversionCategoryBox" ItemsSource="{Binding ConversionCategories}" SelectedItem="{Binding ConversionCategory, Mode=TwoWay}" Style="{StaticResource ToolCombo}" AutomationProperties.Name="Conversion category" />
            <TextBox x:Name="ConversionValueBox" Text="{Binding ConversionValue, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PanelInput}" FontSize="28" Margin="0,14,0,12" AutomationProperties.Name="Value to convert" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding ConversionUnits}" SelectedItem="{Binding ConversionFrom, Mode=TwoWay}" Style="{StaticResource ToolCombo}" AutomationProperties.Name="From unit" /><Button Grid.Column="1" Content="⇄" Click="SwapConversion_Click" Style="{DynamicResource CompactAudioButton}" Margin="8,0" ToolTip="Swap units" /><ComboBox Grid.Column="2" ItemsSource="{Binding ConversionUnits}" SelectedItem="{Binding ConversionTo, Mode=TwoWay}" Style="{StaticResource ToolCombo}" AutomationProperties.Name="To unit" /></Grid>
            <Border Background="#7024252B" CornerRadius="12" Padding="16" Margin="0,17,0,10"><TextBlock Text="{Binding ConversionResult}" Foreground="#F4F2F4" FontSize="28" TextWrapping="Wrap" /></Border>
            <TextBlock Text="{Binding ConversionError}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
            <Button Content="Copy result" Click="CopyConversion_Click" IsEnabled="{Binding CanCopyConversion}" Style="{DynamicResource CompactAudioButton}" />
        </StackPanel>

        <StackPanel Visibility="{Binding IsAudioOutputPanel, Converter={StaticResource VisibleIf}}">
            <TextBlock Text="Search output devices" Foreground="#99A6BC" FontSize="11" Margin="1,0,0,7"/><TextBox x:Name="OutputSearchBox" Text="{Binding OutputFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolSearchInput}" ToolTip="Search output devices" AutomationProperties.Name="Search audio output devices" />
            <ListBox x:Name="OutputList" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput, Mode=TwoWay}" IsEnabled="{Binding CanSwitchOutput}" Margin="0,12,0,0" MaxHeight="260" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ToolRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseLeftButtonUp="OutputList_Click">
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="#F4F2F4" TextTrimming="CharacterEllipsis" FontSize="13" /><TextBlock Grid.Column="1" Text="✓ Current" Foreground="#B5CAE8" FontSize="11" Margin="10,0,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleIf}}" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ToolMessage}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" /><Button Grid.Column="1" Content="Refresh" Click="RefreshOutputs_Click" Style="{DynamicResource CompactAudioButton}" /></Grid>
        </StackPanel>
        <TextBlock Text="Esc back" FontSize="10.5" Foreground="#7E8797" HorizontalAlignment="Right" Margin="0,18,0,0" />
    </StackPanel>
</UserControl>
