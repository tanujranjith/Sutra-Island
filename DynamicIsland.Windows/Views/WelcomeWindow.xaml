<Window x:Class="DynamicIsland.Windows.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Sutra Island" Width="1080" Height="700" MinWidth="940" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#101017" Foreground="#F7F5FF" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#7864F9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="22,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#302D40"/></Style>
        <Style x:Key="VoiceItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3F0FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="7" Margin="4,2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#48405F"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#51476D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="VoiceDropdown" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F7F5FF"/><Setter Property="Background" Value="#282533"/><Setter Property="Height" Value="44"/><Setter Property="ItemContainerStyle" Value="{StaticResource VoiceItem}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Border" CornerRadius="9" Background="#282533" BorderBrush="#5C546D" BorderThickness="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#B7A6FF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#B7A6FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="13,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="⌄" FontSize="18" Foreground="#BDB3D4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,2" IsHitTestVisible="False"/>
                <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#24212E" BorderBrush="#5C546D" BorderThickness="1" CornerRadius="10" Margin="0,5,0,0" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260" CanContentScroll="True"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup>
            </Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#151321" Offset="0"/><GradientStop Color="#101017" Offset="0.55"/><GradientStop Color="#191526" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#B0100F18" BorderBrush="#332E40" BorderThickness="0,0,1,0"><Grid Margin="26,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="✦" FontSize="24" Foreground="#B7A3FF"/><TextBlock Text="SUTRA ISLAND" FontSize="13" FontWeight="Bold" Foreground="#F4F0FF" Margin="0,10,0,4"/><TextBlock Text="A better kind of desktop." FontSize="11" Foreground="#9A93AB"/></StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="YOUR SETUP" Foreground="#817A91" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,18"/><TextBlock x:Name="NavWelcome" Text="01   Welcome" Margin="0,0,0,18"/><TextBlock x:Name="NavIsland" Text="02   Your island" Margin="0,0,0,18"/><TextBlock x:Name="NavFlow" Text="03   Try dictation" Margin="0,0,0,18"/><TextBlock x:Name="NavVoice" Text="04   Your voice" Margin="0,0,0,18"/><TextBlock x:Name="NavReady" Text="05   You’re ready"/></StackPanel>
            <TextBlock Grid.Row="2" Text="Made for your flow." Foreground="#817A91" FontSize="11"/>
        </Grid></Border>
        <Grid Grid.Column="1" Margin="42,32,42,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_Drag"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="GETTING STARTED" FontWeight="Bold" FontSize="11" Foreground="#AFA2DD" VerticalAlignment="Center"/><TextBlock x:Name="ProgressLabel" Grid.Column="1" Foreground="#A9A0B7" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="2" Content="✕" Click="Close_Click" Margin="20,0,0,0" Padding="8,4" Background="#302D40" Style="{StaticResource SecondaryButton}" ToolTip="Close walkthrough" AutomationProperties.Name="Close walkthrough"/></Grid>
            <Grid Grid.Row="1" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,30,0"><StackPanel VerticalAlignment="Center" Margin="0,24,0,20">
                    <TextBlock x:Name="Eyebrow" Foreground="#B5A5FF" FontSize="11" FontWeight="Bold" Margin="0,0,0,13"/>
                    <TextBlock x:Name="Headline" FontSize="34" FontWeight="Bold" LineHeight="42" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Description" Foreground="#C3BBCF" FontSize="15" LineHeight="24" TextWrapping="Wrap" Margin="0,16,0,22"/>
                    <StackPanel x:Name="IslandPanel" Visibility="Collapsed"><WrapPanel><Button x:Name="ToggleIslandButton" Content="Expand the island" Click="ToggleIsland_Click" Style="{StaticResource SecondaryButton}"/><Button Content="Open Assistant" Click="OpenAssistant_Click" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"/></WrapPanel><TextBlock x:Name="IslandActionStatus" Text="Look at the real island at the top of your screen." Foreground="#AAA2B9" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
                    <StackPanel x:Name="FlowPanel" Visibility="Collapsed"><TextBlock x:Name="FlowInstructions" Foreground="#E9E2FA" TextWrapping="Wrap" Margin="0,0,0,9"/><TextBox x:Name="PracticeText" MinHeight="82" AcceptsReturn="True" TextWrapping="Wrap" Background="#262330" Foreground="#F7F5FF" CaretBrush="White" BorderBrush="#5C546D" Padding="12" FontSize="14" AutomationProperties.Name="Dictation practice field"/><TextBlock x:Name="FlowFeedback" Foreground="#B7A3FF" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
                    <StackPanel x:Name="VoicePanel" Visibility="Collapsed"><TextBlock Text="YOUR LOCAL VOICE" FontSize="10" FontWeight="Bold" Foreground="#AAA0B8" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="VoiceChoice" Style="{StaticResource VoiceDropdown}" AutomationProperties.Name="Choose a local voice"/><Button x:Name="PreviewVoiceButton" Grid.Column="1" Content="▶  Preview" Margin="10,0,0,0" Click="PreviewVoice_Click" Style="{StaticResource SecondaryButton}"/></Grid><TextBlock x:Name="VoiceFeedback" Foreground="#AAA2B9" TextWrapping="Wrap" Margin="0,10,0,0"/><CheckBox x:Name="WakeChoice" Margin="0,20,0,0" Foreground="#F7F5FF" Content="Listen for “Hey Sutra”"/><TextBlock Text="Optional. Uses your microphone for local wake detection." Foreground="#AAA2B9" FontSize="12" TextWrapping="Wrap" Margin="22,7,0,0"/></StackPanel>
                </StackPanel></ScrollViewer>
                <Border Grid.Column="1" CornerRadius="20" Background="#B11E1B2A" BorderBrush="#443D56" BorderThickness="1" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><Ellipse Width="7" Height="7" Fill="#8FE5B7" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text="  LIVE ISLAND" Foreground="#C8BDDD" FontWeight="Bold" FontSize="10"/><TextBlock Text="YOUR DESKTOP" Foreground="#817A91" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
                    <Border Grid.Row="1" CornerRadius="14" Background="#FF111018" Margin="0,20" ClipToBounds="True"><Grid><Rectangle x:Name="LiveIslandPreview" Stretch="Fill" Margin="12"/><TextBlock x:Name="PreviewFallback" Text="Your island is ready above." Foreground="#A9A0B7" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid></Border>
                    <StackPanel Grid.Row="2"><TextBlock x:Name="LiveStatus" Text="Connected to your island" Foreground="#F3EEFC" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="Hint" Foreground="#AAA2B9" TextWrapping="Wrap" LineHeight="19" Margin="0,7,0,0" FontSize="12"/></StackPanel>
                </Grid></Border>
            </Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BackButton" Content="←  Back" Click="Back_Click" Style="{StaticResource SecondaryButton}"/><TextBlock x:Name="FooterHint" Grid.Column="1" Foreground="#817A91" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button x:Name="NextButton" Grid.Column="2" Content="Continue  →" Click="Next_Click" Style="{StaticResource PrimaryButton}" MinWidth="134"/></Grid>
        </Grid>
    </Grid>
</Window>
